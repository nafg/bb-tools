{
  "name": "bb-plugin-converse",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bbPluginSdk": "^0.4.1"
  },
  "scripts": {
    "build": "bleep --directory .. link converse && cp ../.bleep/builds/normal/.bloop/converse/link-output/debug/js/main.js server.js && bleep --directory .. link converse-app && cp ../.bleep/builds/normal/.bloop/converse-app/link-output/debug/js/main.js app-core.cjs",
    "test": "bleep --directory .. test converse-core-test",
    "reload": "npm run build && bb plugin build . && bb plugin reload converse"
  },
  "bb": {
    "name": "Converse",
    "description": "Two-way voice conversations with agent threads: continuous listening, transcription into the thread, and spoken replies.",
    "branding": {
      "icon": "Mic"
    },
    "server": "./server.js",
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/react": "^19.2.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.2",
    "vaul": "^1.1.2"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "@ricky0123/vad-web": "0.0.30",
    "onnxruntime-web": "1.27.0"
  }
}
