#!/usr/bin/bash
set -u

readonly bb_url="http://127.0.0.1:38886"
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/bb-window"
readonly log_file="$state_dir/bb-app.log"
readonly lock_file="${XDG_RUNTIME_DIR:-/tmp}/bb-window-start.lock"

bb_is_ready() {
    curl --fail --silent --max-time 1 "$bb_url/health" >/dev/null
}

mkdir -p "$state_dir"
exec 9>"$lock_file"
flock 9

if ! bb_is_ready; then
    : >"$log_file"
    nohup /usr/bin/env npx -y bb-app@latest >>"$log_file" 2>&1 &
    bb_pid=$!

    for _ in {1..240}; do
        if bb_is_ready; then
            break
        fi
        if ! kill -0 "$bb_pid" 2>/dev/null; then
            notify-send "bb failed to start" "See $log_file"
            exit 1
        fi
        sleep 0.25
    done

    if ! bb_is_ready; then
        notify-send "bb startup timed out" "See $log_file"
        exit 1
    fi
fi

flock --unlock 9
exec /home/naftoli/.local/libexec/bb-window-ui
